<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>StaticResourceURLPath__c</fullName>
    <description>URL prefix used to display a static resource, either from the internal org or from the Connect portal.</description>
    <externalId>false</externalId>
    <formula>CASE(TEXT($Profile.UserType),
  &quot;Standard&quot;, &quot;/resource/&quot;,
  &quot;/sfsites/c/resource/&quot;)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Static Resource URL Path</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
