<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DetailRebateAmount__c</fullName>
    <description>Invoice Line applied trade allowance charge (DetailRebatePrice__c * DetailQty__c) (in invoice currency)</description>
    <externalId>false</externalId>
    <formula>ROUND(DetailRebatePrice__c *  DetailQty__c,2)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Invoice Line rebate</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
