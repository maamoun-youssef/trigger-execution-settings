<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PDS_Dates</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISNULL(BDate__c )), NOT(ISNULL(EDate__c)), BDate__c &gt; EDate__c)</errorConditionFormula>
    <errorMessage>End date must be greater than or equal to the begin date.</errorMessage>
</ValidationRule>
