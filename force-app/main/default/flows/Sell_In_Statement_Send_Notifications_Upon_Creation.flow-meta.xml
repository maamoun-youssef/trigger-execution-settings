    <formulas>
        <name>Client_Logo_Formula</name>
        <dataType>String</dataType>
        <expression>LEFT(
  {!$Api.Partner_Server_URL_630},
  FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_630}) - 1
) &amp; &quot;/servlet/servlet.ImageServer?id=&quot; &amp; {!Get_Client_Logo.Id}  &amp; &quot;&amp;oid=&quot; &amp; {!$Organization.Id}</expression>
    </formulas>
    <formulas>
        <name>DynamicSellInStatementListURL</name>
        <dataType>String</dataType>
        <expression>&quot;/sellin-statement-matrix?c__negoScopeId=&quot;&amp;{!$Record.NegoScope__c} &amp;&quot;&amp;c__referenceYear=&quot;&amp;Text({!$Record.ReferenceYear__c}) &amp;&quot;&amp;c__periodType=&quot;&amp;text({!$Record.PeriodType__c}) &amp;&quot;&amp;c__periodNumber=&quot;&amp;text({!$Record.PeriodNumber__c})</expression>
    </formulas>
    <formulas>
        <name>Email_Logo_Formula</name>
        <dataType>String</dataType>
        <expression>LEFT(
  {!$Api.Partner_Server_URL_630},
  FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_630}) - 1
) &amp; &quot;/servlet/servlet.ImageServer?id=&quot; &amp; {!Get_Ulit_Logo.Id}  &amp; &quot;&amp;oid=&quot; &amp; {!$Organization.Id}</expression>
    </formulas>
    <formulas>
        <name>FullSellInStatementURL</name>
        <dataType>String</dataType>
        <expression>{!Get_Custom_URL.Domain.Domain}&amp;{!Get_Custom_URL.PathPrefix}&amp;{!DynamicSellInStatementListURL}</expression>
    </formulas>
    <formulas>
        <name>LongNameFormula</name>
        <dataType>String</dataType>
        <expression>{!$Record.NegoScope__r.Name}
+ &quot; - &quot;
+   TEXT({!$Record.ReferenceYear__c})
+ &quot; - &quot; +
IF(
    TEXT({!Loop_Connect_Users.LanguageLocaleKey}) = &quot;fr&quot;,
    CASE(
        TEXT({!$Record.PeriodType__c}),
        &quot;Month&quot;, &quot;Mensuelle&quot;,
        &quot;Trimester&quot;, &quot;Trimestrielle&quot;,
        &quot;Semester&quot;, &quot;Semestrielle&quot;,
        &quot;Annual&quot;, &quot;Annuelle&quot;,
        &quot;&quot;
    ),
    TEXT({!$Record.PeriodType__c})
) 
+ &apos; - &apos; +
CASE(
    TEXT({!$Record.PeriodType__c}),
    &quot;Month&quot;, {!Period_Type_Label.value},
    &quot;Trimester&quot;, {!Period_Type_Label.value} + &quot; &quot; + TEXT( {!$Record.PeriodNumber__c} ),
    &quot;Semester&quot;, {!Period_Type_Label.value} + &quot; &quot; + TEXT( {!$Record.PeriodNumber__c} ),
    &quot;Annual&quot;, TEXT( {!$Record.PeriodNumber__c} ),
     &quot;&quot;
)
+ &quot; - (&quot; + TEXT( {!$Record.Version__c} ) + &quot;)&quot;</expression>
    </formulas>
    <formulas>
        <name>PeriodTypeFormula</name>
        <dataType>String</dataType>
        <expression>CASE(
    TEXT( {!$Record.PeriodType__c} ),
    &quot;Month&quot;,
    CASE(
        TEXT( {!$Record.PeriodNumber__c} ),
        &quot;1&quot;, &quot;LBL_January&quot;,
        &quot;2&quot;, &quot;LBL_February&quot;,
        &quot;3&quot;, &quot;LBL_March&quot;,
        &quot;4&quot;, &quot;LBL_April&quot;,
        &quot;5&quot;, &quot;LBL_May&quot;,
        &quot;6&quot;, &quot;LBL_June&quot;,
        &quot;7&quot;, &quot;LBL_July&quot;,
        &quot;8&quot;, &quot;LBL_August&quot;,
        &quot;9&quot;, &quot;LBL_September&quot;,
        &quot;10&quot;, &quot;LBL_October&quot;,
        &quot;11&quot;, &quot;LBL_November&quot;,
        &quot;12&quot;, &quot;LBL_December&quot;,
        &quot;&quot;
    ),
    &quot;Trimester&quot;, &quot;LBL_Trimester&quot;,
    &quot;Semester&quot;, &quot;LBL_Semester&quot;,
    &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>PushNotificationSubject_Formula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Loop_Connect_Users.LanguageLocaleKey})=&quot;fr&quot;,&quot;Nouvelle déclaration de CA à remplir&quot;,&quot;New Sell-In Revenue Statement to complete&quot;)</expression>
    </formulas>
    <formulas>
        <name>PushUpNotificationBody_Formula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Loop_Connect_Users.LanguageLocaleKey})=&quot;fr&quot;,&quot;Vous avez reçu une nouvelle déclaration de CA à remplir: &quot;&amp;{!$Record.Name}&amp;&quot;. Cliquez ici pour y accéder.&quot;,&quot;You have received a new Sell-In Revenue Statement to complete: &quot;&amp;{!$Record.Name}&amp;&quot;. Click here to access it.&quot;)</expression>
    </formulas>
    <formulas>
        <name>RequestedEmailNotificationBody_Formula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Loop_Connect_Users.LanguageLocaleKey})=&apos;fr&apos;,{!RequestedEmailNotificationBodyFR},{!RequestedEmailNotificationBodyEN})</expression>
    </formulas>
    <formulas>
        <name>RequestedEmailNotificationSubject_Formula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Loop_Connect_Users.LanguageLocaleKey})=&apos;fr&apos;,&quot;Connect - Nouvelle déclaration de CA à remplir&quot;,&quot;Connect - New Sell-In Revenue Statement to complete&quot;)</expression>
    </formulas>
    <formulas>
        <name>TaskDescription_Formula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Loop_Connect_Users.LanguageLocaleKey})=&apos;fr&apos;,&quot;Action Requise - Merci de remplir votre nouvelle déclaration de CA &quot;&amp;{!$Record.Name},&quot;Required Action - Please be sure to complete the new sell-in revenue statement &quot;&amp;{!$Record.Name})</expression>
    </formulas>
    <formulas>
        <name>TaskDueDate_Formula</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+2</expression>
    </formulas>
    <formulas>
        <name>TaskSubject_Formula</name>
        <dataType>String</dataType>
