<html>
<head>
	<title>Forgot Password</title>
</head>
<body style="height: auto; min-height: auto; font-family: Arial, sans-serif; font-size: 12pt; color: #000; background-color: #fff; line-height: 1.5; padding: 20px;">
<p>{{ $Label.LBL_Connect_Email_Greeting }} {{ Receiving_User.FirstName }} {{ Receiving_User.LastName }},</p>

<p>{{ $Label.LBL_Connect_ForgotPassword_Body }}</p>

<p><a href="{{ $Label.LBL_Click_Here_link }}" style="color: #4a86e8; text-decoration: underline;">{{ $Label.LBL_Click_Here_link }} </a></p>

<p>{{ $Label.LBL_Connect_Email_Closing }}</p>

<p>{{ $Label.LBL_Connect_Email_Support }} <strong style="color: #ff6600;">{{ $Label.LBL_Connect_SupportEmail }}</strong></p>
</body>
</html>